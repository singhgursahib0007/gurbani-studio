isted.","translation_pu":null},{"seq":35,"is_header":0,"paragraph":7,"exists_sgpc":1,"exists_taksal":1,"exists_medium":1,"exists_buddhadal":1,"gurmukhi":"ਪੁਨਿ ਆਈ ਦੀਪਕ ਕੀ ਬਾਰੀ ॥੧॥","translit_en":"pun aaiee dheepak kee baaree ||1||","translation_en":"Then comes the turn of Deepak. ||1||","translation_pu":null},{"seq":36,"is_header":0,"paragraph":8,"exists_sgpc":1,"exists_taksal":1,"exists_medium":1,"exists_buddhadal":1,"gurmukhi":"ਕਛੇਲੀ ਪਟਮੰਜਰੀ ਟੋਡੀ ਕਹੀ ਅਲਾਪਿ ॥","translit_en":"kachhelee paTama(n)jaree Toddee kahee alaap ||","translation_en":"Kachhaylee, Patamanjaree and Todee are sung;","translation_pu":null},{"seq":37,"is_header":0,"paragraph":8,"exists_sgpc":1,"exists_taksal":1,"exists_medium":1,"exists_buddhadal":1,"gurmukhi":"ਕਾਮੋਦੀ ਅਉ ਗੂਜਰੀ ਸੰਗਿ ਦੀਪਕ ਕੇ ਥਾਪਿ ॥੧॥","translit_en":"kaamodhee aau goojaree sa(n)g dheepak ke thaap ||1||","translation_en":"Kaamodee and Goojaree accompany Deepak. ||1||","translation_pu":null},{"seq":38,"is_header":0,"paragraph":9,"exists_sgpc":1,"exists_taksal":1,"exists_medium":1,"exists_buddhadal":1,"gurmukhi":"ਕਾਲੰਕਾ ਕੁੰਤਲ ਅਉ ਰਾਮਾ ॥","translit_en":"kaala(n)kaa ku(n)tal aau raamaa ||","translation_en":"Kaalankaa, Kuntal and Raamaa,","translation_pu":null},{"seq":39,"is_header":0,"paragraph":9,"exists_sgpc":1,"exists_taksal":1,"exists_medium":1,"exists_buddhadal":1,"gurmukhi":"ਕਮਲਕੁਸਮ ਚੰਪਕ ਕੇ ਨਾਮਾ ॥","translit_en":"kamalakusam cha(n)pak ke naamaa ||","translation_en":"Kamalakusam and Champak are their names;","translation_pu":null},{"seq":40,"is_header":0,"paragraph":9,"exists_sgpc":1,"exists_taksal":1,"exists_medium":1,"exists_buddhadal":1,"gurmukhi":"ਗਉਰਾ ਅਉ ਕਾਨਰਾ ਕਲੵਾਨਾ ॥","translit_en":"gauraa aau kaanaraa kalayeaanaa ||","translation_en":"Gauraa, Kaanaraa and Kaylaanaa;","translation_pu":null},{"seq":41,"is_header":0,"paragraph":9,"exists_sgpc":1,"exists_taksal":1,"exists_medium":1,"exists_buddhadal":1,"gurmukhi":"ਅਸਟ ਪੁਤ੍ਰ ਦੀਪਕ ਕੇ ਜਾਨਾ ॥੧॥","translit_en":"asaT putr dheepak ke jaanaa ||1||","translation_en":"these are the eight sons