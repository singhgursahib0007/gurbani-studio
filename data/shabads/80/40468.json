{"shabad":{"shabad_id":40468,"source_id":"B","writer_id":22,"raag_id":0,"page_no":21,"shabad_name":null,"verse_count":7,"first_verse_id":203808,"last_verse_id":203814,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203808,"page_no":21,"line_no":4,"gurmukhi":"੪ : ਕਾਦਰ ਨੂੰ ਕੀਤੇ ਨਹੀਂ ਜਾਣਦੇ","translit_en":"4 : kaadhar noo(n) keete nahee(n) jaanadhe","translation":{"en":{"bdb":"People know not the works of  creator    "}}},{"verse_id":203809,"page_no":21,"line_no":4,"gurmukhi":"ਸੁਣਿ ਆਖਾਣਿ ਵਖਾਣੁ ਆਖਿ ਵਖਾਣਿਆ।","translit_en":"sun aakhaan vakhaan aakh vakhaaniaa|","translation":{"en":{"bdb":"People go on explaining disconnected rumours"}}},{"verse_id":203810,"page_no":21,"line_no":4,"gurmukhi":"ਹਿੰਦੂ ਮੁਸਲਮਾਣੁ ਨ ਸਚੁ ਸਿਞਾਣਿਆ।","translit_en":"hi(n)dhoo musalamaan na sach sin(j)aaniaa|","translation":{"en":{"bdb":"But none of the Hindus and Muslims has identified the truth."}}},{"verse_id":203811,"page_no":21,"line_no":4,"gurmukhi":"ਦਰਗਹ ਪਤਿ ਪਰਵਾਣੁ ਮਾਣੁ ਨਿਮਾਣਿਆ।","translit_en":"dharageh pat paravaan maan nimaaniaa|","translation":{"en":{"bdb":"Only an humble person is accepted respectfully in the court of the Lord."}}},{"verse_id":203812,"page_no":21,"line_no":4,"gurmukhi":"ਵੇਦ ਕਤੇਬ ਕੁਰਾਣੁ ਨ ਅਖਰੁ ਜਾਣਿਆ।","translit_en":"vedh kateb kuraan na akhar jaaniaa|","translation":{"en":{"bdb":"The Vedas, katebas and the 'Qur'an (i.e. all the scriptures of world) also know not even a single word about Him."}}},{"verse_id":203813,"page_no":21,"line_no":4,"gurmukhi":"ਦੀਨ ਦੁਨੀ ਹੈਰਾਣੁ ਚੋਜ ਵਿਡਾਣਿਆ।","translit_en":"dheen dhunee hairaan choj viddaaniaa|","translation":{"en":{"bdb":"The whole world is wonder-struck to see his wondrous deeds."}}},{"verse_id":203814,"page_no":21,"line_no":4,"gurmukhi":"ਕਾਦਰ ਨੋ ਕੁਰਬਾਣੁ ਕੁਦਰਤਿ ਮਾਣਿਆ ॥੪॥","translit_en":"kaadhar no kurabaan kudharat maaniaa ||4||","translation":{"en":{"bdb":"I am sacrifice unto that creator who Himself is the basic grandeur of His creation."}}}],"nav":{"prev":40467,"next":40469}}