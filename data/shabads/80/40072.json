{"shabad":{"shabad_id":40072,"source_id":"B","writer_id":22,"raag_id":0,"page_no":3,"shabad_name":null,"verse_count":10,"first_verse_id":200603,"last_verse_id":200612,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":200603,"page_no":3,"line_no":3,"gurmukhi":"ਪਉੜੀ ੩ : ਗੁਰੁ ਚੇਲਾ","translit_en":"pauRee 3 : gur chelaa","translation":{"en":{"bdb":"Guru and disciple"}}},{"verse_id":200604,"page_no":3,"line_no":3,"gurmukhi":"ਗੁਰ ਚੇਲਾ ਪਰਵਾਣੁ ਗੁਰਮੁਖਿ ਜਾਣੀਐ।","translit_en":"gur chelaa paravaan gurmukh jaaneeaai|","translation":{"en":{"bdb":"The disciple who obeys the commands of the Guru is called gurmukh."}}},{"verse_id":200605,"page_no":3,"line_no":3,"gurmukhi":"ਗੁਰਮੁਖਿ ਚੋਜਿ ਵਿਡਾਣੁ ਅਕੱਥ ਕਥਾਣੀਐ।","translit_en":"gurmukh choj viddaan aka'th kathaaneeaai|","translation":{"en":{"bdb":"The actions of  the gurmukh are awe-inspiring and their glory is indescribable."}}},{"verse_id":200606,"page_no":3,"line_no":3,"gurmukhi":"ਕੁਦਰਤਿ ਨੋ ਕੁਰਬਾਣੁ ਕਾਦਰੁ ਜਾਣੀਐ।","translit_en":"kudharat no kurabaan kaadhar jaaneeaai|","translation":{"en":{"bdb":"Considering creation as the form of the Creator he feels to be a sacrifice unto it."}}},{"verse_id":200607,"page_no":3,"line_no":3,"gurmukhi":"ਗੁਰਮੁਖਿ ਜਗਿ ਮਿਹਮਾਣੁ ਜਗੁ ਮਿਹਮਾਣੀਐ।","translit_en":"gurmukh jag mihamaan jag mihamaaneeaai|","translation":{"en":{"bdb":"In the world he feels himself as a guest and the world a guest house."}}},{"verse_id":200608,"page_no":3,"line_no":3,"gurmukhi":"ਸਤਿਗੁਰ ਸਤਿ ਸੁਹਾਣੁ ਆਖਿ ਵਖਾਣੀਐ।","translit_en":"satigur sat suhaan aakh vakhaaneeaai|","translation":{"en":{"bdb":"Truth is his real Guru whom he speaks and listens to."}}},{"verse_id":200609,"page_no":3,"line_no":3,"gurmukhi":"ਦਰਿ ਢਾਢੀ ਦਰਵਾਣੁ ਚਵੈ ਗੁਰਬਾਣੀਐ।","translit_en":"dhar ddaaddee dharavaan chavai gurbaaneeaai|","translation":{"en":{"bdb":"Like a  bard, at the doors of the holy congregation, he recites the hymns of the Guru (gurbani)."}}},{"verse_id":200610,"page_no":3,"line_no":3,"gurmukhi":"ਅੰਤਰਿਜਾਮੀ ਜਾਣੁ ਹੇਤੁ ਪਛਾਣੀਐ।","translit_en":"a(n)tarijaamee jaan het pachhaaneeaai|","translation":{"en":{"bdb":"For him the holy congregation is the basis of his acquaintance with the omniscient Lord."}}},{"verse_id":200611,"page_no":3,"line_no":3,"gurmukhi":"ਸਚੁ ਸਬਦੁ ਨੀਸਾਣੁ ਸੁਰਤਿ ਸਮਾਣੀਐ।","translit_en":"sach sabadh neesaan surat samaaneeaai|","translation":{"en":{"bdb":"His consciousness remains absorbed in the graceful true Word."}}},{"verse_id":200612,"page_no":3,"line_no":3,"gurmukhi":"ਇਕੋ ਦਰਿ ਦੀਬਾਣੁ ਸਬਦਿ ਸਿਞਾਣੀਐ ॥੩॥","translit_en":"eiko dhar dheebaan sabadh sin(j)aaneeaai ||3||","translation":{"en":{"bdb":"True court of justice for him is the holy congregation and through Word the true identity of it he establishes in his heart."}}}],"nav":{"prev":40071,"next":40073}}