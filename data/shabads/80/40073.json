{"shabad":{"shabad_id":40073,"source_id":"B","writer_id":22,"raag_id":0,"page_no":3,"shabad_name":null,"verse_count":10,"first_verse_id":200613,"last_verse_id":200622,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":200613,"page_no":3,"line_no":4,"gurmukhi":"ਪਉੜੀ ੪ : ਗੁਰੁ ਚੇਲਾ","translit_en":"pauRee 4 : gur chelaa","translation":{"en":{"bdb":"Guru and disciple"}}},{"verse_id":200614,"page_no":3,"line_no":4,"gurmukhi":"ਸਬਦੁ ਗੁਰੂ ਗੁਰੁ ਵਾਹੁ ਗੁਰਮੁਖਿ ਪਾਇਆ।","translit_en":"sabadh guroo gur vaahu gurmukh paiaa|","translation":{"en":{"bdb":"From the Guru the disciple obtains the wondrous Word"}}},{"verse_id":200615,"page_no":3,"line_no":4,"gurmukhi":"ਚੇਲਾ ਸੁਰਤਿ ਸਮਾਹੁ ਅਲਖੁ ਲਖਾਇਆ।","translit_en":"chelaa surat samaahu alakh lakhaiaa|","translation":{"en":{"bdb":"And as a disciple, merging his consciousness in it, comes face to face with imperceptible Lord."}}},{"verse_id":200616,"page_no":3,"line_no":4,"gurmukhi":"ਗੁਰ ਚੇਲੇ ਵੀਵਾਹੁ ਤੁਰੀ ਚੜਾਇਆ।","translit_en":"gur chele veevaahu turee chaRaiaa|","translation":{"en":{"bdb":"Meeting the Guru, the disciple attains turia, the fourth and final stage  of spiritual quietude."}}},{"verse_id":200617,"page_no":3,"line_no":4,"gurmukhi":"ਗਹਰਿ ਗੰਭੀਰ ਅਥਾਹੁ ਅਜਰੁ ਜਰਾਇਆ।","translit_en":"gahar ga(n)bheer athaahu ajar jaraiaa|","translation":{"en":{"bdb":"He holds unfathomable and serene Lord dearly in his heart."}}},{"verse_id":200618,"page_no":3,"line_no":4,"gurmukhi":"ਸਚਾ ਬੇਪਰਵਾਹੁ ਸਚਿ ਸਮਾਇਆ।","translit_en":"sachaa beparavaahu sach samaiaa|","translation":{"en":{"bdb":"Becoming carefree that true disciple merges himself in the truth."}}},{"verse_id":200619,"page_no":3,"line_no":4,"gurmukhi":"ਪਾਤਿਸਾਹਾ ਪਾਤਿਸਾਹੁ ਹੁਕਮੁ ਚਲਾਇਆ।","translit_en":"paatisaahaa paatisaahu hukam chalaiaa|","translation":{"en":{"bdb":"And by becoming the king of kings he makes others subservient to him."}}},{"verse_id":200620,"page_no":3,"line_no":4,"gurmukhi":"ਲਉਬਾਲੀ ਦਰਗਾਹੁ ਭਾਣਾ ਭਾਇਆ।","translit_en":"laubaalee dharagaahu bhaanaa bhaiaa|","translation":{"en":{"bdb":"Only he loves the divine will of the Lord."}}},{"verse_id":200621,"page_no":3,"line_no":4,"gurmukhi":"ਸਚੀ ਸਿਫਤਿ ਸਲਾਹੁ ਅਪਿਉ ਪੀਆਇਆ।","translit_en":"sachee sifat salaahu apiau peeaaiaa|","translation":{"en":{"bdb":"And only he has tasted the nectar in the form of praises of the Lord."}}},{"verse_id":200622,"page_no":3,"line_no":4,"gurmukhi":"ਸਬਦੁ ਸੁਰਤਿ ਅਸਗਾਹੁ ਅਘੜ ਘੜਾਇਆ ॥੪॥","translit_en":"sabadh surat asagaahu aghaR ghaRaiaa ||4||","translation":{"en":{"bdb":"Taking consciousness into the depth of Word, he has shaped the unchiselled mind."}}}],"nav":{"prev":40072,"next":40074}}