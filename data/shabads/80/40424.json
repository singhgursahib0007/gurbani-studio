{"shabad":{"shabad_id":40424,"source_id":"B","writer_id":22,"raag_id":0,"page_no":19,"shabad_name":null,"verse_count":7,"first_verse_id":203499,"last_verse_id":203505,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203499,"page_no":19,"line_no":2,"gurmukhi":"੨ : ਚੌਰਾਸੀ ਦੇ ਵਿਖੇ","translit_en":"2 : chauaraasee dhe vikhe","translation":{"en":{"bdb":"The best among the eightyfour lakhs of species of life  "}}},{"verse_id":203500,"page_no":19,"line_no":2,"gurmukhi":"ਲਖ ਚਉਰਾਸੀਹ ਜੂਨਿ ਫੇਰਿ ਫਿਰਾਇਆ।","translit_en":"lakh chauraaseeh joon fer firaiaa|","translation":{"en":{"bdb":"Souls wander fruitlessly in the eighty-four lakhs of species of life."}}},{"verse_id":203501,"page_no":19,"line_no":2,"gurmukhi":"ਮਾਣਸ ਜਨਮੁ ਦੁਲੰਭ ਕਰਮੀ ਪਾਇਆ।","translit_en":"maanas janam dhula(n)bh karamee paiaa|","translation":{"en":{"bdb":"The rare human body has been obtained owing to virtuous actions."}}},{"verse_id":203502,"page_no":19,"line_no":2,"gurmukhi":"ਉਤਮੁ ਗੁਰਮੁਖਿ ਪੰਥੁ ਆਪੁ ਗਵਾਇਆ।","translit_en":"autam gurmukh pa(n)th aap gavaiaa|","translation":{"en":{"bdb":"Moving on greatest path of the Guru orientated, the self has lost the ego."}}},{"verse_id":203503,"page_no":19,"line_no":2,"gurmukhi":"ਸਾਧਸੰਗਤਿ ਰਹਰਾਸਿ ਪੈਰੀ ਪਾਇਆ।","translit_en":"saadhasa(n)gat raharaas pairee paiaa|","translation":{"en":{"bdb":"Maintaining the discipline of the holy congregation has come to fall at the feet (of the Guru)."}}},{"verse_id":203504,"page_no":19,"line_no":2,"gurmukhi":"ਨਾਮ ਦਾਨੁ ਇਸਨਾਨੁ ਸਚੁ ਦਿੜਾਇਆ।","translit_en":"naam dhaan isanaan sach dhiRaiaa|","translation":{"en":{"bdb":"Gurmukhs have adopted the name of the Lord, the charity, the ablution and truthful conduct steadfastly."}}},{"verse_id":203505,"page_no":19,"line_no":2,"gurmukhi":"ਸਬਦੁ ਸੁਰਤਿ ਲਿਵਲੀਣੁ ਭਾਣਾ ਭਾਇਆ ॥੨॥","translit_en":"sabadh surat livaleen bhaanaa bhaiaa ||2||","translation":{"en":{"bdb":"The man has merged his consciousness in the Word and has accepted the will of the Lord."}}}],"nav":{"prev":40423,"next":40425}}