{"shabad":{"shabad_id":40488,"source_id":"B","writer_id":22,"raag_id":0,"page_no":22,"shabad_name":null,"verse_count":9,"first_verse_id":203958,"last_verse_id":203966,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203958,"page_no":22,"line_no":4,"gurmukhi":"੪ : ਸ੍ਰਿਸ਼ਟੀ ਰਚਨਾ","translit_en":"4 : sirashaTee rachanaa","translation":{"en":{"bdb":"The Creation "}}},{"verse_id":203959,"page_no":22,"line_no":4,"gurmukhi":"ਸਚਾ ਸਿਰਜਣਿਹਾਰੁ ਸਚਿ ਸਮਾਇਆ।","translit_en":"sachaa sirajanihaar sach samaiaa|","translation":{"en":{"bdb":"The true Creator as the Truth is pervading one and all."}}},{"verse_id":203960,"page_no":22,"line_no":4,"gurmukhi":"ਸਚਹੁ ਪਉਣ ਉਪਾਇ ਘਟਿ ਘਟਿ ਛਾਇਆ।","translit_en":"sachahu paun upai ghaT ghaT chhaiaa|","translation":{"en":{"bdb":"Out of Truth He created air and (in the form of vital air) is residing in all"}}},{"verse_id":203961,"page_no":22,"line_no":4,"gurmukhi":"ਪਵਣਹੁ ਪਾਣੀ ਸਾਜਿ ਸੀਸੁ ਨਿਵਾਇਆ।","translit_en":"pavanahu paanee saaj sees nivaiaa|","translation":{"en":{"bdb":"From air was created water which always remains humble i.e. it. always moves down wards."}}},{"verse_id":203962,"page_no":22,"line_no":4,"gurmukhi":"ਤੁਲਹਾ ਧਰਤਿ ਬਣਾਇ ਨੀਰ ਤਰਾਇਆ।","translit_en":"tulahaa dharat banai neer taraiaa|","translation":{"en":{"bdb":"Earth as a raft is made to float on water."}}},{"verse_id":203963,"page_no":22,"line_no":4,"gurmukhi":"ਨੀਰਹੁ ਉਪਜੀ ਅਗਿ ਵਣਖੰਡੁ ਛਾਇਆ।","translit_en":"neerahu upajee ag vanakha(n)dd chhaiaa|","translation":{"en":{"bdb":"From water emerged fire which spread throughout the whole vegetation."}}},{"verse_id":203964,"page_no":22,"line_no":4,"gurmukhi":"ਅਗੀ ਹੋਦੀ ਬਿਰਖੁ ਸੁਫਲ ਫਲਾਇਆ।","translit_en":"agee hodhee birakh sufal falaiaa|","translation":{"en":{"bdb":"By virtue of this very fire (heat) the trees became. full of fruits"}}},{"verse_id":203965,"page_no":22,"line_no":4,"gurmukhi":"ਪਉਣ ਪਾਣੀ ਬੈਸੰਤਰ ਮੇਲਿ ਮਿਲਾਇਆ।","translit_en":"paun paanee baisa(n)tar mel milaiaa|","translation":{"en":{"bdb":"In this way, air, water and fire were integrated under the order of that primaeval Lord"}}},{"verse_id":203966,"page_no":22,"line_no":4,"gurmukhi":"ਆਦਿ ਪੁਰਖੁ ਆਦੇਸੁ ਖੇਲੁ ਰਚਾਇਆ ॥੪॥","translit_en":"aadh purakh aadhes khel rachaiaa ||4||","translation":{"en":{"bdb":"And thus was this game of creation arranged."}}}],"nav":{"prev":40487,"next":40489}}