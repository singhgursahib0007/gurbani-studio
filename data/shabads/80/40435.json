{"shabad":{"shabad_id":40435,"source_id":"B","writer_id":22,"raag_id":0,"page_no":19,"shabad_name":null,"verse_count":7,"first_verse_id":203577,"last_verse_id":203583,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203577,"page_no":19,"line_no":13,"gurmukhi":"੧੩ : ਗੁਰਮੁਖ ਕਰਨੀ","translit_en":"13 : gurmukh karanee","translation":{"en":{"bdb":"Conduct of the gurmukh "}}},{"verse_id":203578,"page_no":19,"line_no":13,"gurmukhi":"ਗੁਰਮੁਖਿ ਆਪੁ ਗਵਾਇ ਆਪੁ ਪਛਾਣਿਆ॥","translit_en":"gurmukh aap gavai aap pachhaaniaa||","translation":{"en":{"bdb":"The Gurmukh losing his ego and identifies his self."}}},{"verse_id":203579,"page_no":19,"line_no":13,"gurmukhi":"ਗੁਰਮੁਖਿ ਸਤਿ ਸੰਤੋਖੁ ਸਹਜਿ ਸਮਾਣਿਆ।","translit_en":"gurmukh sat sa(n)tokh sahaj samaaniaa|","translation":{"en":{"bdb":"The Gurmukh enters his innate nature through truth and contentment."}}},{"verse_id":203580,"page_no":19,"line_no":13,"gurmukhi":"ਗੁਰਮੁਖਿ ਧੀਰਜੁ ਧਰਮੁ ਦਇਆ ਸੁਖੁ ਮਾਣਿਆ।","translit_en":"gurmukh dheeraj dharam dhiaa sukh maaniaa|","translation":{"en":{"bdb":"The Gurmukh alone enjoys the true delights of forbearance, dharma and compassion."}}},{"verse_id":203581,"page_no":19,"line_no":13,"gurmukhi":"ਗੁਰਮੁਖਿ ਅਰਥ ਵੀਚਾਰਿ ਸਬਦੁ ਵਖਾਣਿਆ।","translit_en":"gurmukh arath veechaar sabadh vakhaaniaa|","translation":{"en":{"bdb":"Gurmukhs very well understand the importance of the words first, and only then they speak them out."}}},{"verse_id":203582,"page_no":19,"line_no":13,"gurmukhi":"ਗੁਰਮੁਖਿ ਹੋਂਦੇ ਤਾਣ ਰਹੈ ਨਿਤਾਣਿਆ।","translit_en":"gurmukh ho(n)dhe taan rahai nitaaniaa|","translation":{"en":{"bdb":"Though being powerful, the gurmukhs always consider themselves weak and humble."}}},{"verse_id":203583,"page_no":19,"line_no":13,"gurmukhi":"ਗੁਰਮੁਖਿ ਦਰਗਹ ਮਾਣੁ ਹੋਇ ਨਿਮਾਣਿਆ ॥੧੩॥","translit_en":"gurmukh dharageh maan hoi nimaaniaa ||13||","translation":{"en":{"bdb":"Because the gurmukhs are polite, they receive respects in the court of the Lord."}}}],"nav":{"prev":40434,"next":40436}}