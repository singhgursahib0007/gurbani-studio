{"shabad":{"shabad_id":40449,"source_id":"B","writer_id":22,"raag_id":0,"page_no":20,"shabad_name":null,"verse_count":7,"first_verse_id":203676,"last_verse_id":203682,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203676,"page_no":20,"line_no":6,"gurmukhi":"੬ : ਗੁਰਸਿੱਖ ਕਮਾਈ","translit_en":"6 : gursi'kh kamaiee","translation":{"en":{"bdb":"The earning of Gurmukh "}}},{"verse_id":203677,"page_no":20,"line_no":6,"gurmukhi":"ਪੈਰੀ ਪੈ ਗੁਰਸਿਖ ਪੈਰ ਧੁਆਇਆ।","translit_en":"pairee pai gursikh pair dhuaaiaa|","translation":{"en":{"bdb":"Touching the feet, the Sikhs of the Guru wash their feet."}}},{"verse_id":203678,"page_no":20,"line_no":6,"gurmukhi":"ਅੰਮ੍ਰਿਤਵਾਣੀ ਚਖਿ ਮਨੁ ਵਸਿ ਆਇਆ।","translit_en":"a(n)mritavaanee chakh man vas aaiaa|","translation":{"en":{"bdb":"Then they taste the ambrosial word (of Guru) through which the mind is controlled."}}},{"verse_id":203679,"page_no":20,"line_no":6,"gurmukhi":"ਪਾਣੀ ਪਖਾ ਪੀਹਿ ਭਠੁ ਝੁਕਾਇਆ।","translit_en":"paanee pakhaa peeh bhaTh jhukaiaa|","translation":{"en":{"bdb":"They fetch water, fan the sangat and put wood in the firebox of the kitchen."}}},{"verse_id":203680,"page_no":20,"line_no":6,"gurmukhi":"ਗੁਰਬਾਣੀ ਸੁਣਿ ਸਿਖਿ ਲਿਖਿ ਲਿਖਾਇਆ।","translit_en":"gurbaanee sun sikh likh likhaiaa|","translation":{"en":{"bdb":"They listen to, write and make others write the hymns of the Gurus."}}},{"verse_id":203681,"page_no":20,"line_no":6,"gurmukhi":"ਨਾਮੁ ਦਾਨੁ ਇਸਨਾਨੁ ਕਰਮ ਕਮਾਇਆ।","translit_en":"naam dhaan isanaan karam kamaiaa|","translation":{"en":{"bdb":"They practice the remembrance of Lords name, charity and ablutions."}}},{"verse_id":203682,"page_no":20,"line_no":6,"gurmukhi":"ਨਿਵ ਚਲਣੁ ਮਿਠ ਬੋਲ ਘਾਲਿ ਖਵਾਇਆ ॥੬॥","translit_en":"niv chalan miTh bol ghaal khavaiaa ||6||","translation":{"en":{"bdb":"They walk in humility, speak sweetly, and eat the earning of their own hands."}}}],"nav":{"prev":40448,"next":40450}}