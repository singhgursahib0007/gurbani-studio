{"shabad":{"shabad_id":40325,"source_id":"B","writer_id":22,"raag_id":0,"page_no":14,"shabad_name":null,"verse_count":7,"first_verse_id":202712,"last_verse_id":202718,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":202712,"page_no":14,"line_no":9,"gurmukhi":"ਪਉੜੀ ੯ : ਬ੍ਰਿਛ ਦੇ ਹੋਰ ਉਪਕਾਰ","translit_en":"pauRee 9 : birachh dhe hor upakaar","translation":{"en":{"bdb":"Other gifts of the trees"}}},{"verse_id":202713,"page_no":14,"line_no":9,"gurmukhi":"ਰੁਖਹੁ ਘਰ ਛਾਵਾਇ ਥੰਮ੍ਹ ਥਮਾਇਆ।","translit_en":"rukhahu ghar chhaavai tha(n)mh thamaiaa|","translation":{"en":{"bdb":"From tree are made houses and pillars."}}},{"verse_id":202714,"page_no":14,"line_no":9,"gurmukhi":"ਸਿਰਿ ਕਰਵਤੁ ਧਰਾਇ ਬੇੜ ਘੜਾਇਆ।","translit_en":"sir karavat dharai beR ghaRaiaa|","translation":{"en":{"bdb":"A tree getting sawed helps to make boat."}}},{"verse_id":202715,"page_no":14,"line_no":9,"gurmukhi":"ਲੋਹੇ ਨਾਲਿ ਜੜਾਇ ਪੂਰ ਤਰਾਇਆ।","translit_en":"lohe naal jaRai poor taraiaa|","translation":{"en":{"bdb":"Then adding iron (nails) to it, it gets people float on water."}}},{"verse_id":202716,"page_no":14,"line_no":9,"gurmukhi":"ਲਖ ਲਹਰੀ ਦਰੀਆਇ ਪਾਰਿ ਲੰਘਾਇਆ।","translit_en":"lakh laharee dhareeaai paar la(n)ghaiaa|","translation":{"en":{"bdb":"In spite of the myriads of waves of river, it takes people across."}}},{"verse_id":202717,"page_no":14,"line_no":9,"gurmukhi":"ਗੁਰਸਿਖਾਂ ਭੈ ਭਾਇ ਸਬਦੁ ਕਮਾਇਆ।","translit_en":"gursikhaa(n) bhai bhai sabadh kamaiaa|","translation":{"en":{"bdb":"Likewise, the Sikhs of the Guru, in love and fear of the Lord, practise the Word."}}},{"verse_id":202718,"page_no":14,"line_no":9,"gurmukhi":"ਇਕਸ ਪਿਛੈ ਲਾਇ ਲਖ ਛੁਡਾਇਆ ॥੯॥","translit_en":"eikas pichhai lai lakh chhuddaiaa ||9||","translation":{"en":{"bdb":"They make people follow the one Lord and get them liberated from the bondages of transmigration."}}}],"nav":{"prev":40324,"next":40326}}