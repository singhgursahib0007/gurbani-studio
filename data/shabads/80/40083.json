{"shabad":{"shabad_id":40083,"source_id":"B","writer_id":22,"raag_id":0,"page_no":3,"shabad_name":null,"verse_count":9,"first_verse_id":200712,"last_verse_id":200720,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":200712,"page_no":3,"line_no":14,"gurmukhi":"ਪਉੜੀ ੧੪ : ਉਪਰਲੇ ਭਾਵ","translit_en":"pauRee 14 : uparale bhaav","translation":{"en":{"bdb":"Gurmukh"}}},{"verse_id":200713,"page_no":3,"line_no":14,"gurmukhi":"ਗੁਰਮੁਖਿ ਸਬਦ ਸਮ੍ਹਾਲ ਸੁਰਤਿ ਸਮਾਲੀਐ।","translit_en":"gurmukh sabadh samhaal surat samaaleeaai|","translation":{"en":{"bdb":"The words of gurmukh should always be cherished in one’s heart."}}},{"verse_id":200714,"page_no":3,"line_no":14,"gurmukhi":"ਗੁਰਮੁਖਿ ਨਦਰਿ ਨਿਹਾਲ ਨੇਹ ਨਿਹਾਲੀਐ।","translit_en":"gurmukh nadhar nihaal neh nihaaleeaai|","translation":{"en":{"bdb":"By the  benevolent glance of the gurmukh one becomes blest and happy."}}},{"verse_id":200715,"page_no":3,"line_no":14,"gurmukhi":"ਗੁਰਮੁਖਿ ਸੇਵਾ ਘਾਲਿ ਵਿਰਲੇ ਘਾਲੀਐ।","translit_en":"gurmukh sevaa ghaal virale ghaaleeaai|","translation":{"en":{"bdb":"Rare are those who attain the sense of discipline and service."}}},{"verse_id":200716,"page_no":3,"line_no":14,"gurmukhi":"ਗੁਰਮੁਖਿ ਦੀਨ ਦਇਆਲ ਹੇਤੁ ਹਿਆਲੀਐ।","translit_en":"gurmukh dheen dhiaal het hiaaleeaai|","translation":{"en":{"bdb":"Gurmukhs being full of love are kind to the poor."}}},{"verse_id":200717,"page_no":3,"line_no":14,"gurmukhi":"ਗੁਰਮੁਖਿ ਨਿਬਹੈ ਨਾਲਿ ਗੁਰਸਿਖ ਪਾਲੀਐ।","translit_en":"gurmukh nibahai naal gursikh paaleeaai|","translation":{"en":{"bdb":"Gurmukh is ever steadfast and always adheres to the teachings of the Guru."}}},{"verse_id":200718,"page_no":3,"line_no":14,"gurmukhi":"ਰਤਨ ਪਦਾਰਥ ਲਾਲ ਗੁਰਮੁਖਿ ਭਾਲੀਐ।","translit_en":"ratan padhaarath laal gurmukh bhaaleeaai|","translation":{"en":{"bdb":"One should seek jewels and rubies from the gurmukhs."}}},{"verse_id":200719,"page_no":3,"line_no":14,"gurmukhi":"ਗੁਰਮੁਖਿ ਅਕਲ ਅਕਾਲ ਭਗਤਿ ਸੁਖਾਲੀਐ।","translit_en":"gurmukh akal akaal bhagat sukhaaleeaai|","translation":{"en":{"bdb":"Gurmukhs are devoid of deception; they, without becoming victim of Time, go on enjoying the delight of devotion."}}},{"verse_id":200720,"page_no":3,"line_no":14,"gurmukhi":"ਗੁਰਮੁਖਿ ਹੰਸਾ ਢਾਲਿ ਰਸਿਕ ਰਸਾਲੀਐ ॥੧੪॥","translit_en":"gurmukh ha(n)saa ddaal rasik rasaaleeaai ||14||","translation":{"en":{"bdb":"Gurmukhs have discriminatory wisdom of swans (who can separate milk from water), and they with their mind and body love their Lord."}}}],"nav":{"prev":40082,"next":40084}}