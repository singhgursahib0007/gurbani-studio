{"shabad":{"shabad_id":40459,"source_id":"B","writer_id":22,"raag_id":0,"page_no":20,"shabad_name":null,"verse_count":7,"first_verse_id":203745,"last_verse_id":203751,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203745,"page_no":20,"line_no":16,"gurmukhi":"੧੬ : ਓਹੋ ਹੀ","translit_en":"16 : oho hee","translation":{"en":{"bdb":"Yoga-technique for Gursikhs "}}},{"verse_id":203746,"page_no":20,"line_no":16,"gurmukhi":"ਮੁੰਦ੍ਰਾ ਗੁਰ ਉਪਦੇਸੁ ਮੰਤ੍ਰ ਸੁਣਾਇਆ।","translit_en":"mu(n)dhraa gur upadhes ma(n)tr sunaiaa|","translation":{"en":{"bdb":"The sermon of the Guru is the earrings of a yogi."}}},{"verse_id":203747,"page_no":20,"line_no":16,"gurmukhi":"ਖਿੰਥਾ ਖਿਮਾ ਸਿਵਾਇ ਝੋਲੀ ਪਤਿ ਮਾਇਆ।","translit_en":"khi(n)thaa khimaa sivai jholee pat maiaa|","translation":{"en":{"bdb":"Forgiveness is the patched blanket and in the beggar's bad is the name of the Lord of maya (God)."}}},{"verse_id":203748,"page_no":20,"line_no":16,"gurmukhi":"ਪੈਰੀ ਪੈ ਪਾਖਾਕ ਬਿਭੂਤ ਬਣਾਇਆ।","translit_en":"pairee pai paakhaak bibhoot banaiaa|","translation":{"en":{"bdb":"Humbly touching of the feet ashes."}}},{"verse_id":203749,"page_no":20,"line_no":16,"gurmukhi":"ਪਿਰਮ ਪਿਆਲਾ ਪਤ ਭੋਜਨੁ ਭਾਇਆ।","translit_en":"piram piaalaa pat bhojan bhaiaa|","translation":{"en":{"bdb":"Cup of love is the bowl, which is filled with the food of affection."}}},{"verse_id":203750,"page_no":20,"line_no":16,"gurmukhi":"ਡੰਡਾ ਗਿਆਨ ਵਿਚਾਰੁ ਦੂਤ ਸਿਧਾਇਆ।","translit_en":"dda(n)ddaa giaan vichaar dhoot sidhaiaa|","translation":{"en":{"bdb":"Knowledge is the staff with which the messengers of different propensities of mind are cultured."}}},{"verse_id":203751,"page_no":20,"line_no":16,"gurmukhi":"ਸਹਜ ਗੁਫਾ ਸਤਿਸੰਗੁ ਸਮਾਧਿ ਸਮਾਇਆ ॥੧੬॥","translit_en":"sahaj gufaa satisa(n)g samaadh samaiaa ||16||","translation":{"en":{"bdb":"Holy congregation is the tranquil cave wherein the yogi resides in equipoise."}}}],"nav":{"prev":40458,"next":40460}}