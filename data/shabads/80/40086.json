{"shabad":{"shabad_id":40086,"source_id":"B","writer_id":22,"raag_id":0,"page_no":3,"shabad_name":null,"verse_count":10,"first_verse_id":200740,"last_verse_id":200749,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":200740,"page_no":3,"line_no":17,"gurmukhi":"ਪਉੜੀ ੧੭ : ਗੁਰਮੁਖ ਅੰਜਨ","translit_en":"pauRee 17 : gurmukh a(n)jan","translation":{"en":{"bdb":"Collyrium of the Gursikhs"}}},{"verse_id":200741,"page_no":3,"line_no":17,"gurmukhi":"ਹੋਈ ਆਗਿਆ ਆਦਿ ਆਦਿ ਨਿਰੰਜਨੋ।","translit_en":"hoiee aagiaa aadh aadh nira(n)jano|","translation":{"en":{"bdb":"In the primordial times the Lord ordained."}}},{"verse_id":200742,"page_no":3,"line_no":17,"gurmukhi":"ਨਾਦੈ ਮਿਲਿਆ ਨਾਦੁ ਹਉਮੈ ਭੰਜਨੋ।","translit_en":"naadhai miliaa naadh haumai bha(n)jano|","translation":{"en":{"bdb":"The Word of the Guru met with the Sabda-brahm Word-God and the ego of creatures got erased."}}},{"verse_id":200743,"page_no":3,"line_no":17,"gurmukhi":"ਬਿਸਮਾਦੈ ਬਿਸਮਾਦੁ ਗੁਰਮੁਖਿ ਅੰਜਨੋ।","translit_en":"bisamaadhai bisamaadh gurmukh a(n)jano|","translation":{"en":{"bdb":"This  very awe-inspiring word is the collyrium of gurmukhs."}}},{"verse_id":200744,"page_no":3,"line_no":17,"gurmukhi":"ਗੁਰਮਤਿ ਗੁਰ ਪ੍ਰਸਾਦਿ ਭਰਮੁ ਨਿਖੰਜਨੋ।","translit_en":"gurmat gur prasaadh bharam nikha(n)jano|","translation":{"en":{"bdb":"Adopting Gurmat, the wisdom of the Guru, with the grace of the Guru, the delusions are  eschewed."}}},{"verse_id":200745,"page_no":3,"line_no":17,"gurmukhi":"ਆਦਿ ਪੁਰਖੁ ਪਰਮਾਦਿ ਅਕਾਲ ਅਗੰਜਨੋ।","translit_en":"aadh purakh paramaadh akaal aga(n)jano|","translation":{"en":{"bdb":"That primordial being is beyond time and destruction."}}},{"verse_id":200746,"page_no":3,"line_no":17,"gurmukhi":"ਸੇਵਕ ਸਿਵ ਸਨਕਾਦਿ ਕ੍ਰਿਪਾ ਕਰੰਜਨੋ।","translit_en":"sevak siv sanakaadh kirapaa kara(n)jano|","translation":{"en":{"bdb":"He  bestows grace upon His servants like Siva and Sanaks et al."}}},{"verse_id":200747,"page_no":3,"line_no":17,"gurmukhi":"ਜਪੀਐ ਜੁਗਹੁ ਜੁਗਾਦਿ ਗੁਰਸਿਖ ਮੰਜਨੋ।","translit_en":"japeeaai jugahu jugaadh gursikh ma(n)jano|","translation":{"en":{"bdb":"In all the ages only He is remembered and He alone is the object of concentration of the Sikhs."}}},{"verse_id":200748,"page_no":3,"line_no":17,"gurmukhi":"ਪਿਰਮ ਪਿਆਲੇ ਸਾਦੁ ਪਰਮ ਪੁਰੰਜਨੋ।","translit_en":"piram piaale saadh param pura(n)jano|","translation":{"en":{"bdb":"Through the taste of the cup of love that Supreme Love is known."}}},{"verse_id":200749,"page_no":3,"line_no":17,"gurmukhi":"ਆਦਿ ਜੁਗਾਦਿ ਅਨਾਦਿ ਸਰਬ ਸੁਰੰਜਨੋ ॥੧੭॥","translit_en":"aadh jugaadh anaadh sarab sura(n)jano ||17||","translation":{"en":{"bdb":"Since the primordial time He has been delighting all."}}}],"nav":{"prev":40085,"next":40087}}