{"shabad":{"shabad_id":40429,"source_id":"B","writer_id":22,"raag_id":0,"page_no":19,"shabad_name":null,"verse_count":7,"first_verse_id":203535,"last_verse_id":203541,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203535,"page_no":19,"line_no":7,"gurmukhi":"੭ : ਚਲਣ ਜੁਗਤ-ਪੇਕਾ","translit_en":"7 : chalan jugata-pekaa","translation":{"en":{"bdb":"Way of the world - parent's home -"}}},{"verse_id":203536,"page_no":19,"line_no":7,"gurmukhi":"ਗੁਰਮੁਖਿ ਮਨਿ ਪਰਗਾਸੁ ਗੁਰਿ ਉਪਦੇਸਿਆ।","translit_en":"gurmukh man paragaas gur upadhesiaa|","translation":{"en":{"bdb":"The gurmukh who have received well with the Guru's teachings have got their minds enlightened."}}},{"verse_id":203537,"page_no":19,"line_no":7,"gurmukhi":"ਪੇਈਅੜੈ ਘਰਿ ਵਾਸੁ ਮਿਟੈ ਅੰਦੇਸਿਆ।","translit_en":"peieeaRai ghar vaas miTai a(n)dhesiaa|","translation":{"en":{"bdb":"They have understood that the world is like a parental home; one has to go one day from here and hence all their doubts have been removed."}}},{"verse_id":203538,"page_no":19,"line_no":7,"gurmukhi":"ਆਸਾ ਵਿਚਿ ਨਿਰਾਸੁ ਗਿਆਨੁ ਅਵੇਸਿਆ।","translit_en":"aasaa vich niraas giaan avesiaa|","translation":{"en":{"bdb":"They are unattached amid hopes and remain charged with the knowledge."}}},{"verse_id":203539,"page_no":19,"line_no":7,"gurmukhi":"ਸਾਧਸੰਗਤਿ ਰਹਰਾਸਿ ਸਬਦਿ ਸੰਦੇਸਿਆ।","translit_en":"saadhasa(n)gat raharaas sabadh sa(n)dhesiaa|","translation":{"en":{"bdb":"They spread message of the Word in accordance with the conduct of the holy congregation."}}},{"verse_id":203540,"page_no":19,"line_no":7,"gurmukhi":"ਗੁਰਮੁਖਿ ਦਾਸਨਿ ਦਾਸ ਮਤ ਪਰਵੇਸਿਆ।","translit_en":"gurmukh dhaasan dhaas mat paravesiaa|","translation":{"en":{"bdb":"The idea that they are servants of the servants of the Lord has got deeply rooted in the wisdom of the gurmukhs."}}},{"verse_id":203541,"page_no":19,"line_no":7,"gurmukhi":"ਸਿਮਰਣ ਸਾਸ ਗਿਰਾਸ ਦੇਸ ਵਿਦੇਸਿਆ ॥੭॥","translit_en":"simaran saas giraas dhes vidhesiaa ||7||","translation":{"en":{"bdb":"Be they anywhere in the country or abroad they remember God with every inhalation and exhalation of breath."}}}],"nav":{"prev":40428,"next":40430}}