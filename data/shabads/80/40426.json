{"shabad":{"shabad_id":40426,"source_id":"B","writer_id":22,"raag_id":0,"page_no":19,"shabad_name":null,"verse_count":8,"first_verse_id":203513,"last_verse_id":203520,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203513,"page_no":19,"line_no":4,"gurmukhi":"੪ : ਚੱਲਣ ਜੁਗਤ ਗੋਇਲ","translit_en":"4 : cha'lan jugat goil","translation":{"en":{"bdb":"Method of moving around , "}}},{"verse_id":203514,"page_no":19,"line_no":4,"gurmukhi":"ਗੋਇਲੜਾ ਦਿਨ ਚਾਰਿ ਗੁਰਮੁਖਿ ਜਾਣੀਐ।","translit_en":"goilaRaa dhin chaar gurmukh jaaneeaai|","translation":{"en":{"bdb":"Gurmukh knows this world as a place of rest for a few days."}}},{"verse_id":203515,"page_no":19,"line_no":4,"gurmukhi":"ਮੰਝੀ ਲੈ ਮਿਹਵਾਰਿ ਚੋਜ ਵਿਡਾਣੀਐ।","translit_en":"ma(n)jhee lai mihavaar choj viddaaneeaai|","translation":{"en":{"bdb":"Here with the help of wealth many types of sports and feats are enacted."}}},{"verse_id":203516,"page_no":19,"line_no":4,"gurmukhi":"ਵਰਸੈ ਨਿਝਰ ਧਾਰਿ ਅੰਮ੍ਰਿਤ ਵਾਣੀਐ।","translit_en":"varasai nijhar dhaar a(n)mirat vaaneeaai|","translation":{"en":{"bdb":"In this very world, for gurmukhs incessant rain of nectar goes on pouring."}}},{"verse_id":203517,"page_no":19,"line_no":4,"gurmukhi":"ਵੰਝੁਲੀਐ ਝੀਗਾਰਿ ਮਜਲਸ ਮਾਣੀਐ।","translit_en":"va(n)jhuleeaai jheegaar majalas maaneeaai|","translation":{"en":{"bdb":"On the tune of flute (the unstruck melody) they go on enjoying the delight of the assembly."}}},{"verse_id":203518,"page_no":19,"line_no":4,"gurmukhi":"ਗਾਵਣਿ ਮਾਝ ਮਲਾਰਿ ਸੁਘੜੁ ਸੁਜਾਣੀਐ।","translit_en":"gaavan maajh malaar sughaR sujaaneeaai|","translation":{"en":{"bdb":"Well-trained and knowledgeable persons sing Majh and Malhar musical measures here i.e. they enjoy the present."}}},{"verse_id":203519,"page_no":19,"line_no":4,"gurmukhi":"ਹਉਮੈ ਗਰਬੁ ਨਿਵਾਰਿ ਮਨਿ ਵਸਿ ਆਣੀਐ।","translit_en":"haumai garab nivaar man vas aaneeaai|","translation":{"en":{"bdb":"They lose their ego and control their minds."}}},{"verse_id":203520,"page_no":19,"line_no":4,"gurmukhi":"ਗੁਰਮੁਖਿ ਸਬਦੁ ਵੀਚਾਰਿ ਸਚਿ ਸਿਞਾਣੀਐ ॥੪॥","translit_en":"gurmukh sabadh veechaar sach sin(j)aaneeaai ||4||","translation":{"en":{"bdb":"Contemplating the Word, the Gurmukh identifies the truth."}}}],"nav":{"prev":40425,"next":40427}}