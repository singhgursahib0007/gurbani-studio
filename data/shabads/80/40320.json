{"shabad":{"shabad_id":40320,"source_id":"B","writer_id":22,"raag_id":0,"page_no":14,"shabad_name":null,"verse_count":7,"first_verse_id":202677,"last_verse_id":202683,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":202677,"page_no":14,"line_no":4,"gurmukhi":"ਪਉੜੀ ੪ : ਬ੍ਰਹਮਾ , ਵਿਸ਼ਨੂੰ, ਮਹੇਸ਼","translit_en":"pauRee 4 : brahamaa , vishanoo(n), mahesh","translation":{"en":{"bdb":"Brahma,Visnu,Mahesa"}}},{"verse_id":202678,"page_no":14,"line_no":4,"gurmukhi":"ਬਿਸਨੈ ਦਸ ਅਵਤਾਰ ਨਾਵ ਗਣਾਇਆ।","translit_en":"bisanai dhas avataar naav ganaiaa|","translation":{"en":{"bdb":"Visnu incarnated ten times and established his names."}}},{"verse_id":202679,"page_no":14,"line_no":4,"gurmukhi":"ਕਰਿ ਕਰਿ ਅਸੁਰ ਸੰਘਾਰ ਵਾਦੁ ਵਧਾਇਆ।","translit_en":"kar kar asur sa(n)ghaar vaadh vadhaiaa|","translation":{"en":{"bdb":"Destroying the demons he increased the conflicts."}}},{"verse_id":202680,"page_no":14,"line_no":4,"gurmukhi":"ਬ੍ਰਹਮੈ ਵੇਦ ਵੀਚਾਰਿ ਆਖਿ ਸੁਣਾਇਆ।","translit_en":"brahamai vedh veechaar aakh sunaiaa|","translation":{"en":{"bdb":"Brahma thoughtfully recited the four Vedas;"}}},{"verse_id":202681,"page_no":14,"line_no":4,"gurmukhi":"ਮਨ ਅੰਦਰਿ ਅਹੰਕਾਰੁ ਜਗਤੁ ਉਪਾਇਆ।","translit_en":"man a(n)dhar aha(n)kaar jagat upaiaa|","translation":{"en":{"bdb":"But created the universe out of his ego."}}},{"verse_id":202682,"page_no":14,"line_no":4,"gurmukhi":"ਮਹਾਦੇਉ ਲਾਇ ਤਾਰ ਤਾਮਸੁ ਤਾਇਆ।","translit_en":"mahaadheau lai taar taamas taiaa|","translation":{"en":{"bdb":"Siva being engrossed in tamas always remained vexed and angry."}}},{"verse_id":202683,"page_no":14,"line_no":4,"gurmukhi":"ਗੁਰਮੁਖਿ ਮੋਖ ਦੁਆਰ ਆਪੁ ਗਵਾਇਆ ॥੪॥","translit_en":"gurmukh mokh dhuaar aap gavaiaa ||4||","translation":{"en":{"bdb":"Only gurmukhs, the Guru orientated, forswearing their ego reach the door of liberation."}}}],"nav":{"prev":40319,"next":40321}}