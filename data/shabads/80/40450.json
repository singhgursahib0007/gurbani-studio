{"shabad":{"shabad_id":40450,"source_id":"B","writer_id":22,"raag_id":0,"page_no":20,"shabad_name":null,"verse_count":7,"first_verse_id":203683,"last_verse_id":203689,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203683,"page_no":20,"line_no":7,"gurmukhi":"੭ : ਗੁਰਸਿੱਖਾਂ ਦੇ ਮੇਲ ਵਿਖੇ","translit_en":"7 : gursi'khaa(n) dhe mel vikhe","translation":{"en":{"bdb":"Metting of the Sikhs of the Guru   "}}},{"verse_id":203684,"page_no":20,"line_no":7,"gurmukhi":"ਗੁਰਸਿੱਖਾਂ ਗੁਰਸਿਖ ਮੇਲਿ ਮਿਲਾਇਆ।","translit_en":"gursi'khaa(n) gursikh mel milaiaa|","translation":{"en":{"bdb":"The Sikhs of Guru meet the Sikhs of the Guru."}}},{"verse_id":203685,"page_no":20,"line_no":7,"gurmukhi":"ਭਾਇ ਭਗਤਿ ਗੁਰਪੁਰਬ ਕਰੈ ਕਰਾਇਆ।","translit_en":"bhai bhagat gurapurab karai karaiaa|","translation":{"en":{"bdb":"Bound by the loving devotion, they celebrate the anniversaries of the Guru."}}},{"verse_id":203686,"page_no":20,"line_no":7,"gurmukhi":"ਗੁਰਸਿਖ ਦੇਵੀ ਦੇਵ ਜਠੇਰੇ ਭਾਇਆ।","translit_en":"gursikh dhevee dhev jaThere bhaiaa|","translation":{"en":{"bdb":"For them, the Sikh of the Guru is the god, goddess and the father."}}},{"verse_id":203687,"page_no":20,"line_no":7,"gurmukhi":"ਗੁਰਸਿਖ ਮਾਂ ਪਿਉ ਵੀਰ ਕੁਟੰਬ ਸਬਾਇਆ।","translit_en":"gursikh maa(n) piau veer kuTa(n)b sabaiaa|","translation":{"en":{"bdb":"Mother, father, brother and the family also is the Sikh of the Guru."}}},{"verse_id":203688,"page_no":20,"line_no":7,"gurmukhi":"ਗੁਰਸਿਖ ਖੇਤੀ ਵਣਜੁ ਲਾਹਾ ਪਾਇਆ।","translit_en":"gursikh khetee vanaj laahaa paiaa|","translation":{"en":{"bdb":"Meeting to the Sikhs of the Guru is farming business as well as other gainful occupations for the Sikh."}}},{"verse_id":203689,"page_no":20,"line_no":7,"gurmukhi":"ਹੰਸ ਵੰਸ ਗੁਰਸਿਖ ਗੁਰਸਿਖ ਜਾਇਆ ॥੭॥","translit_en":"ha(n)s va(n)s gursikh gursikh jaiaa ||7||","translation":{"en":{"bdb":"The progeny of the swan like Sikhs of Guru is also the Sikh of the Guru."}}}],"nav":{"prev":40449,"next":40451}}