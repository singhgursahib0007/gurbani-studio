{"shabad":{"shabad_id":40328,"source_id":"B","writer_id":22,"raag_id":0,"page_no":14,"shabad_name":null,"verse_count":7,"first_verse_id":202733,"last_verse_id":202739,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":202733,"page_no":14,"line_no":12,"gurmukhi":"ਪਉੜੀ ੧੨ : ਗੁਰਮੁਖ ਕਪਾਹ ਵਾਂਗ ਕਸ਼ਟ ਸਹਾਰਦੇ ਹਨ","translit_en":"pauRee 12 : gurmukh kapaeh vaa(n)g kashaT sahaaradhe han","translation":{"en":{"bdb":"Gurmukhs tolerate sufferings like cotton"}}},{"verse_id":202734,"page_no":14,"line_no":12,"gurmukhi":"ਦੁਖ ਸਹੈ ਕਪਾਹਿ ਭਾਣਾ ਭਾਇਆ।","translit_en":"dhukh sahai kapaeh bhaanaa bhaiaa|","translation":{"en":{"bdb":"Accepting the will of the Lord, cotton suffers a lot."}}},{"verse_id":202735,"page_no":14,"line_no":12,"gurmukhi":"ਵੇਲਣਿ ਵੇਲ ਵਿਲਾਇ ਤੁੰਬਿ ਤੁੰਬਾਇਆ।","translit_en":"velan vel vilai tu(n)b tu(n)baiaa|","translation":{"en":{"bdb":"Having been ginned through the roller, it is carded."}}},{"verse_id":202736,"page_no":14,"line_no":12,"gurmukhi":"ਪਿੰਞਣਿ ਪਿੰਜ ਫਿਰਾਇ ਸੂਤੁ ਕਤਾਇਆ।","translit_en":"pi(n)n(j)n pi(n)j firai soot kataiaa|","translation":{"en":{"bdb":"Having carded it, its yarn is spun."}}},{"verse_id":202737,"page_no":14,"line_no":12,"gurmukhi":"ਨਲੀ ਜੁਲਾਹੇ ਵਾਹਿ ਚੀਰੁ ਵੁਣਾਇਆ।","translit_en":"nalee julaahe vaeh cheer vunaiaa|","translation":{"en":{"bdb":"Then the weaver with the help of his reed, eaves it into cloth."}}},{"verse_id":202738,"page_no":14,"line_no":12,"gurmukhi":"ਖੁੰਬ ਚੜਾਇਨਿ ਬਾਹਿ ਨੀਰਿ ਧੁਵਾਇਆ।","translit_en":"khu(n)b chaRain baeh neer dhuvaiaa|","translation":{"en":{"bdb":"The washerman puts that cloth into his boiling cauldron and then washes it on a stream."}}},{"verse_id":202739,"page_no":14,"line_no":12,"gurmukhi":"ਪੈਨ੍ਹਿ ਸਾਹਿ ਪਾਤਿਸਾਹਿ ਸਭਾ ਸੁਹਾਇਆ ॥੧੨॥","translit_en":"paineh saeh paatisaeh sabhaa suhaiaa ||12||","translation":{"en":{"bdb":"Putting on the same clothes, the rich and the kings adorn the assemblies."}}}],"nav":{"prev":40327,"next":40329}}