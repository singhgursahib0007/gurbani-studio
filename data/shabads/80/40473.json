{"shabad":{"shabad_id":40473,"source_id":"B","writer_id":22,"raag_id":0,"page_no":21,"shabad_name":null,"verse_count":8,"first_verse_id":203844,"last_verse_id":203851,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203844,"page_no":21,"line_no":9,"gurmukhi":"੯ : ਭਾਉ ਭਗਤਿ ਤੋਂ ਬਿਨਾਂ ਪਰਚੇ","translit_en":"9 : bhaau bhagat to(n) binaa(n) parache","translation":{"en":{"bdb":"With loving devotion, all is futile    "}}},{"verse_id":203845,"page_no":21,"line_no":9,"gurmukhi":"ਲਖ ਸਾਹਿਬਿ ਸਿਰਦਾਰ ਆਵਣ ਜਾਵਣੇ।","translit_en":"lakh saahib siradhaar aavan jaavane|","translation":{"en":{"bdb":"Many masters and leaders come and go."}}},{"verse_id":203846,"page_no":21,"line_no":9,"gurmukhi":"ਲਖ ਵਡੇ ਦਰਬਾਰ ਬਣਤ ਬਣਾਵਣੇ।","translit_en":"lakh vadde dharabaar banat banaavane|","translation":{"en":{"bdb":"Many majestic courts exist and their stores are so full of wealth"}}},{"verse_id":203847,"page_no":21,"line_no":9,"gurmukhi":"ਦਰਬ ਭਰੇ ਭੰਡਾਰ ਗਣਤ ਗਣਾਵਣੇ।","translit_en":"dharab bhare bha(n)ddaar ganat ganaavane|","translation":{"en":{"bdb":"That continuous counting goes on there (to avoid any deficiency)."}}},{"verse_id":203848,"page_no":21,"line_no":9,"gurmukhi":"ਪਰਵਾਰੈ ਸਾਧਾਰ ਬਿਰਦ ਸਦਾਵਣੇ।","translit_en":"paravaarai saadhaar biradh sadhaavane|","translation":{"en":{"bdb":"Many becoming helping hand to many families are sticking to their words and protect their reputation."}}},{"verse_id":203849,"page_no":21,"line_no":9,"gurmukhi":"ਲੋਭ ਮੋਹ ਅਹੰਕਾਰ ਧੋਹ ਕਮਾਵਣੇ।","translit_en":"lobh moh aha(n)kaar dhoh kamaavane|","translation":{"en":{"bdb":"Many, controlled by greed, infatuation and ego, go on swindling and cheating."}}},{"verse_id":203850,"page_no":21,"line_no":9,"gurmukhi":"ਕਰਦੇ ਚਾਰੁ ਵੀਚਾਰਿ ਦਹਦਿਸਿ ਧਾਵਣੇ।","translit_en":"karadhe chaar veechaar dhahadhis dhaavane|","translation":{"en":{"bdb":"Many are there who talking and discoursing sweetly wander in all the ten directions."}}},{"verse_id":203851,"page_no":21,"line_no":9,"gurmukhi":"ਲਖ ਲਖ ਬੁਜਰਕਵਾਰ ਮਨ ਪਰਚਾਵਣੇ ॥੯॥","translit_en":"lakh lakh bujarakavaar man parachaavane ||9||","translation":{"en":{"bdb":"Millions are old people who are still swinging their mind in the hopes and desires."}}}],"nav":{"prev":40472,"next":40474}}