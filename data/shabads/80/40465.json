{"shabad":{"shabad_id":40465,"source_id":"B","writer_id":22,"raag_id":0,"page_no":21,"shabad_name":null,"verse_count":8,"first_verse_id":203786,"last_verse_id":203793,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203786,"page_no":21,"line_no":1,"gurmukhi":"ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ॥","translit_en":"ikOankaar satigur prasaadh||","translation":{"en":{"bdb":"One Oankar, the primal energy, realized through the grace of divine preceptor"}}},{"verse_id":203787,"page_no":21,"line_no":1,"gurmukhi":"੧ : ਪਉੜੀ ਮੰਗਲਾਚਰਨ ਵਾਹਿਗੁਰੂ ਗੁਰੂ ਮਹਿੰਮਾ","translit_en":"1 : pauRee ma(n)galaacharan vaahiguroo guroo mahi(n)maa","translation":{"en":{"bdb":"One Oankar, the primal energy, realized through the grace of divine preceptor"}}},{"verse_id":203788,"page_no":21,"line_no":1,"gurmukhi":"ਪਾਤਿਸਾਹਾ ਪਾਤਿਸਾਹੁ ਸਤਿ ਸੁਹਾਣੀਐ।","translit_en":"paatisaahaa paatisaahu sat suhaaneeaai|","translation":{"en":{"bdb":"The Lord is the emperor of the emperors, the truth and the beautiful"}}},{"verse_id":203789,"page_no":21,"line_no":1,"gurmukhi":"ਵਡਾ ਬੇਪਰਵਾਹੁ ਅੰਤੁ ਨ ਜਾਣੀਐ।","translit_en":"vaddaa beparavaahu a(n)t na jaaneeaai|","translation":{"en":{"bdb":"He, the great, is nonchalant and his mystery cannot be understood"}}},{"verse_id":203790,"page_no":21,"line_no":1,"gurmukhi":"ਲਉਬਾਲੀ ਦਰਗਾਹ ਆਖਿ ਵਖਾਣੀਐ।","translit_en":"laubaalee dharagaeh aakh vakhaaneeaai|","translation":{"en":{"bdb":"His court is also anxiety free."}}},{"verse_id":203791,"page_no":21,"line_no":1,"gurmukhi":"ਕੁਦਰਤਿ ਅਗਮੁ ਅਥਾਹੁ ਚੋਜ ਵਿਡਾਣੀਐ।","translit_en":"kudharat agam athaahu choj viddaaneeaai|","translation":{"en":{"bdb":"The feats of His powers are unfathomable and impervious."}}},{"verse_id":203792,"page_no":21,"line_no":1,"gurmukhi":"ਸਚੀ ਸਿਫਤਿ ਸਲਾਹ ਅਕਥ ਕਹਾਣੀਐ।","translit_en":"sachee sifat salaeh akath kahaaneeaai|","translation":{"en":{"bdb":"His praise is true and the story of His eulogisation is undescribable."}}},{"verse_id":203793,"page_no":21,"line_no":1,"gurmukhi":"ਸਤਿਗੁਰ ਸਚੇ ਵਾਹੁ ਸਦ ਕੁਰਬਾਣੀਐ ॥੧॥","translit_en":"satigur sache vaahu sadh kurabaaneeaai ||1||","translation":{"en":{"bdb":"I accept the true Guru wondrous and offer my life (for His truth)."}}}],"nav":{"prev":40464,"next":40466}}