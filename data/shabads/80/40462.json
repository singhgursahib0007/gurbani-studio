{"shabad":{"shabad_id":40462,"source_id":"B","writer_id":22,"raag_id":0,"page_no":20,"shabad_name":null,"verse_count":7,"first_verse_id":203765,"last_verse_id":203771,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":203765,"page_no":20,"line_no":19,"gurmukhi":"੧੯ : ਸ਼ਤਰੰਜ ਦੀ ਖੇਲ","translit_en":"19 : shatara(n)j dhee khel","translation":{"en":{"bdb":"The game of chess  "}}},{"verse_id":203766,"page_no":20,"line_no":19,"gurmukhi":"ਸਤਰੰਜ ਬਾਜੀ ਖੇਲੁ ਬਿਸਾਤਿ ਬਣਾਇਆ।","translit_en":"satara(n)j baajee khel bisaat banaiaa|","translation":{"en":{"bdb":"The chess players have spread the chess mat."}}},{"verse_id":203767,"page_no":20,"line_no":19,"gurmukhi":"ਹਾਥੀ ਘੋੜੇ ਰਥ ਪਿਆਦੇ ਆਇਆ।","translit_en":"haathee ghoRe rath piaadhe aaiaa|","translation":{"en":{"bdb":"Elephants, chariots, horses and pedestrians have been brought in."}}},{"verse_id":203768,"page_no":20,"line_no":19,"gurmukhi":"ਹੁਇ ਪਤਿਸਾਹੁ ਵਜੀਰ ਦੁਇ ਦਲ ਛਾਇਆ।","translit_en":"hui patisaahu vajeer dhui dhal chhaiaa|","translation":{"en":{"bdb":"The groups of kings and ministers have gathered and are fighting tooth and nail."}}},{"verse_id":203769,"page_no":20,"line_no":19,"gurmukhi":"ਹੋਇ ਗਡਾਵਡਿ ਜੋਧ ਜੁਧੁ ਮਚਾਇਆ।","translit_en":"hoi gaddaavadd jodh judh machaiaa|","translation":{"en":{"bdb":"The groups of kings and ministers have gathered and are fighting tooth and nail."}}},{"verse_id":203770,"page_no":20,"line_no":19,"gurmukhi":"ਗੁਰਮੁਖਿ ਚਾਲ ਚਲਾਇ ਹਾਲ ਪੁਜਾਇਆ।","translit_en":"gurmukh chaal chalai haal pujaiaa|","translation":{"en":{"bdb":"The Gurmukh by making a move has opened his heart before the Guru."}}},{"verse_id":203771,"page_no":20,"line_no":19,"gurmukhi":"ਪਾਇਕ ਹੋਇ ਵਜੀਰੁ ਗੁਰਿ ਪਹੁਚਾਇਆ ॥੧੯॥","translit_en":"paik hoi vajeer gur pahuchaiaa ||19||","translation":{"en":{"bdb":"The Guru has lifted pedestrian to the rank of minister and has placed him in the palace of success (and thus has saved the life game of the disciple)."}}}],"nav":{"prev":40461,"next":40463}}