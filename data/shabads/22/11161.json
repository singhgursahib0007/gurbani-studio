{"shabad":{"shabad_id":11161,"source_id":"D","writer_id":47,"raag_id":63,"page_no":1012,"shabad_name":null,"verse_count":5,"first_verse_id":120627,"last_verse_id":120631,"source_english":"Dasam Bani","source_unicode":"ਦਸਮ ਬਾਣੀ","writer":"Guru Gobind Singh Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":120627,"page_no":1012,"line_no":120627,"gurmukhi":"ਚੌਪਈ ॥","translit_en":"chauapiee ||","translation":{"en":{"bdb":"Chaupaee"},"pu":{"ss":"ਚੌਪਈ:"}}},{"verse_id":120628,"page_no":1012,"line_no":120628,"gurmukhi":"ਹਾਹਿ ਹਾਇ ਤਰ ਪਰਿਯੋ ਉਚਾਰੈ ॥","translit_en":"haeh hai tar pariyo uchaarai ||","translation":{"pu":{"ss":"ਮੰਜੀ ਹੇਠਾ ਪਿਆ ਹਾਇ ਹਾਇ ਕਰਦਾ ਕਹਿਣ ਲਗਾ,"}}},{"verse_id":120629,"page_no":1012,"line_no":120629,"gurmukhi":"ਕਹਾ ਕਰਿਯੋ ਤੈ ਪੀਰ ਹਮਾਰੈ ॥","translit_en":"kahaa kariyo tai peer hamaarai ||","translation":{"en":{"bdb":"Then he cried and said, ‘Oh, Peer, what have you done to me?’"},"pu":{"ss":"ਹੇ ਮੇਰੇ ਪੀਰ! ਤੁਸੀਂ ਕੀ ਕਰ ਰਹੇ ਹੋ।"}}},{"verse_id":120630,"page_no":1012,"line_no":120630,"gurmukhi":"ਤੁਮੈ ਤ੍ਯਾਗ ਮੈ ਅਨਤ ਨ ਧਾਯੋ ॥","translit_en":"tumai tayaag mai anat na dhaayo ||","translation":{"pu":{"ss":"(ਅਗੋਂ ਪੀਰ ਨੇ ਕਿਹਾ) ਮੈਂ ਤੈਨੂੰ ਛਡ ਕੇ ਹੋਰ ਕਿਤੇ ਨਹੀਂ ਜਾਵਾਗਾ।"}}},{"verse_id":120631,"page_no":1012,"line_no":120631,"gurmukhi":"ਜੈਸੋ ਕਿਯੋ ਤੈਸੋ ਫਲ ਪਾਯੋ ॥੧੨॥","translit_en":"jaiso kiyo taiso fal paayo ||12||","translation":{"en":{"bdb":"The Peer responded, ‘You are tasting the fruit of your own action.’ -12"},"pu":{"ss":"ਜਿਹੋ ਜਿਹਾ (ਤੂੰ) ਕੀਤਾ ਹੈ, ਓਹੋ ਜਿਹਾ ਫਲ ਪਾਇਆ ਹੈ ॥੧੨॥"}}}],"nav":{"prev":11160,"next":11162}}