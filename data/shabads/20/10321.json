_no":895,"line_no":114539,"gurmukhi":"ਤੁਰਹੁ ਤਹਾ ਤੇ ਕਾਢ ਮੰਗੈਯੈ ॥","translit_en":"turahu tahaa te kaadd ma(n)gaiyai ||","translation":{"pu":{"ss":"ਉਥੋਂ ਤੁਰਤ ਕਢ ਕੇ ਮੰਗਵਾ ਲਵੋ"}}},{"verse_id":114540,"page_no":895,"line_no":114540,"gurmukhi":"ਆਨਿ ਤ੍ਰਿਯਾ ਕੇ ਬਕ੍ਰ ਲਗੈਯੈ ॥੧੧॥","translit_en":"aan tirayaa ke bakr lagaiyai ||11||","translation":{"en":{"bdb":"“Go, take out immediately and put it on the face of the woman.”(11)"},"pu":{"ss":"ਅਤੇ ਲਿਆ ਕੇ (ਆਪਣੀ) ਇਸਤਰੀ ਦੇ ਮੂੰਹ ਉਤੇ ਲਗਾ ਦਿਓ ॥੧੧॥"}}}],"nav":{"prev":10320,"next":10322}}