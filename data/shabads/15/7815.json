{"shabad":{"shabad_id":7815,"source_id":"D","writer_id":47,"raag_id":55,"page_no":171,"shabad_name":null,"verse_count":17,"first_verse_id":82458,"last_verse_id":82474,"source_english":"Dasam Bani","source_unicode":"ਦਸਮ ਬਾਣੀ","writer":"Guru Gobind Singh Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":82458,"page_no":171,"line_no":82458,"gurmukhi":"ਨਰਾਜ ਛੰਦ ॥","translit_en":"naraaj chha(n)dh ||","translation":{"en":{"bdb":"NARAAJ STANZA"},"pu":{"ss":"ਨਰਾਜ ਛੰਦ:"}}},{"verse_id":82459,"page_no":171,"line_no":82459,"gurmukhi":"ਸਰੂਪ ਛੋਟ ਧਾਰਿ ਕੈ ॥","translit_en":"saroop chhoT dhaar kai ||","translation":{"pu":{"ss":"(ਵਿਸ਼ਣੂ ਬ੍ਰਾਹਮਣ ਦਾ) ਛੋਟਾ ਜਿਹਾ ਰੂਪ ਧਾਰ ਕੇ"}}},{"verse_id":82460,"page_no":171,"line_no":82460,"gurmukhi":"ਚਲਿਯੋ ਤਹਾ ਬਿਚਾਰਿ ਕੈ ॥","translit_en":"chaliyo tahaa bichaar kai ||","translation":{"pu":{"ss":"ਵਿਚਾਰ-ਪੂਰਵਕ ਉਥੋਂ ਚਲਿਆ।"}}},{"verse_id":82461,"page_no":171,"line_no":82461,"gurmukhi":"ਸਭਾ ਨਰੇਸ ਜਾਨ੍ਯੋ ॥","translit_en":"sabhaa nares jaanayo ||","translation":{"pu":{"ss":"ਰਾਜੇ ਦੇ ਦਰਬਾਰ ਨੂੰ ਜਾਣਨ ਉਪਰੰਤ"}}},{"verse_id":82462,"page_no":171,"line_no":82462,"gurmukhi":"ਤਹੀ ਸੁ ਪਾਵ ਠਾਨ੍ਰਯੋ ॥੪॥","translit_en":"tahee su paav Thaanrayo ||4||","translation":{"en":{"bdb":"He transformed himself ad a dwarf and after some reflection, he moved towards the court of the king Bali, where, on reaching, he stood firmly.4."},"pu":{"ss":"ਉਥੇ ਪੈਰ ਗਡ ਦਿੱਤੇ ॥੪॥"}}},{"verse_id":82463,"page_no":171,"line_no":82463,"gurmukhi":"ਸੁ ਬੇਦ ਚਾਰ ਉਚਾਰ ਕੈ ॥","translit_en":"s bedh chaar uchaar kai ||","translation":{"pu":{"ss":"(ਉਸ ਬ੍ਰਾਹਮਣ ਨੇ) ਚੌਹਾ ਵੇਦਾ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਉਚਾਰ ਕੇ"}}},{"verse_id":82464,"page_no":171,"line_no":82464,"gurmukhi":"ਸੁਣ੍ਯੋ ਨ੍ਰਿਪੰ ਸੁਧਾਰ ਕੈ ॥","translit_en":"sunayo nirapa(n) sudhaar kai ||","translation":{"en":{"bdb":"This Brahmin recited all the four Vedas, which the king listened to attentively."},"pu":{"ss":"ਰਾਜੇ ਨੂੰ ਸੁਣਾਇਆ।"}}},{"verse_id":82465,"page_no":171,"line_no":82465,"gurmukhi":"ਬੁਲਾਇ ਬਿਪੁ ਕੋ ਲਯੋ ॥","translit_en":"bulai bip ko layo ||","translation":{"pu":{"ss":"(ਰਾਜੇ ਨੇ) ਬ੍ਰਾਹਮਣ ਨੂੰ (ਆਪਣੇ ਕੋਲ) ਬੁਲਾ ਲਿਆ"}}},{"verse_id":82466,"page_no":171,"line_no":82466,"gurmukhi":"ਮਲਯਾਗਰ ਮੂੜਕਾ ਦਯੋ ॥੫॥","translit_en":"malayaagar mooRakaa dhayo ||5||","translation":{"en":{"bdb":"The king Bali then called the Brahmin and got him seated respectfully on a seat of sandalwood.5."},"pu":{"ss":"ਅਤੇ ਚੰਦਨ ਦੀ ਲਕੜੀ ਦੀ ਬਣੀ ਪੀੜ੍ਰਹੀ (ਬੈਠਣ ਨੂੰ) ਦਿੱਤੀ ॥੫॥"}}},{"verse_id":82467,"page_no":171,"line_no":82467,"gurmukhi":"ਪਦਾਰਘ ਦੀਪ ਦਾਨ ਦੈ ॥","translit_en":"padhaaragh dheep dhaan dhai ||","translation":{"pu":{"ss":"(ਰਾਜੇ ਨੇ ਬ੍ਰਾਹਮਣ ਦੇ) ਪੈਰ ਧੋਤੇ ਅਤੇ ਆਰਤੀ ਉਤਾਰੀ"}}},{"verse_id":82468,"page_no":171,"line_no":82468,"gurmukhi":"ਪ੍ਰਦਛਨਾ ਅਨੇਕ ਕੈ ॥","translit_en":"pradhachhanaa anek kai ||","translation":{"en":{"bdb":"The king quaffed the water, with which the feet of the Brahmin had been washed and offered charities."},"pu":{"ss":"ਤੇ ਅਨੇਕ ਵਾਰ ਪ੍ਰਦਖਣਾ ਕੀਤੀ।"}}},{"verse_id":82469,"page_no":171,"line_no":82469,"gurmukhi":"ਕਰੋਰਿ ਦਛਨਾ ਦਈ ॥","translit_en":"karor dhachhanaa dhiee ||","translation":{"pu":{"ss":"(ਫਿਰ) ਕਰੋੜਾ ਦੱਛਣਾ ਦਿੱਤੀਆਂ"}}},{"verse_id":82470,"page_no":171,"line_no":82470,"gurmukhi":"ਨ ਹਾਥਿ ਬਿਪ ਨੈ ਲਈ ॥੬॥","translit_en":"n haath bip nai liee ||6||","translation":{"en":{"bdb":"Then he circumambulated around the Brahmin several times, after that the king offered millions of charities, but the Brahmin did not touch anything with his hand.6."},"pu":{"ss":"(ਪਰ) ਬ੍ਰਾਹਮਣ ਨੇ (ਕਿਸੇ ਨੂੰ) ਹੱਥ ਤਕ ਨਾ ਲਾਇਆ ॥੬॥"}}},{"verse_id":82471,"page_no":171,"line_no":82471,"gurmukhi":"ਕਹਿਯੋ ਨ ਮੋਰ ਕਾਜ ਹੈ ॥","translit_en":"kahiyo na mor kaaj hai ||","translation":{"pu":{"ss":"(ਬ੍ਰਾਹਮਣ ਨੇ) ਕਿਹਾ ਕਿ ਇਹ ਮੇਰੇ ਕਿਸੇ ਕੰਮ ਨਹੀਂ।"}}},{"verse_id":82472,"page_no":171,"line_no":82472,"gurmukhi":"ਮਿਥ੍ਯਾ ਇਹ ਤੋਰ ਸਾਜ ਹੈ ॥","translit_en":"mithayaa ieh tor saaj hai ||","translation":{"en":{"bdb":"The Brahmin said that all those things were of no use to him and all the ostentations offered by the king were false."},"pu":{"ss":"ਇਹ ਤੇਰੇ (ਸਾਰੇ) ਸਾਜ ਮਿਥਿਆ ਹਨ।"}}},{"verse_id":82473,"page_no":171,"line_no":82473,"gurmukhi":"ਅਢਾਇ ਪਾਵ ਭੂਮਿ ਦੈ ॥","translit_en":"addai paav bhoom dhai ||","translation":{"pu":{"ss":"(ਮੈਨੂੰ) ਢਾਈ ਕਦਮ ਭੂਮੀ ਪ੍ਰਦਾਨ ਕਰ।"}}},{"verse_id":82474,"page_no":171,"line_no":82474,"gurmukhi":"ਬਸੇਖ ਪੂਰ ਕੀਰਤਿ ਲੈ ॥੭॥","translit_en":"basekh poor keerat lai ||7||","translation":{"en":{"bdb":"He then asked him to give only two and a half steps of the earth  and accept the special eulogy.7."},"pu":{"ss":"ਉਸ (ਦੇ ਫਲ ਵਜੋਂ) ਹੇ ਰਾਜਨ! ਵਿਸ਼ੇਸ਼ ਯਸ਼ ਅਰਜਿਤ ਕਰ ॥੭॥"}}}],"nav":{"prev":7814,"next":7816}}