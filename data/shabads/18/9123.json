{"shabad":{"shabad_id":9123,"source_id":"D","writer_id":47,"raag_id":55,"page_no":539,"shabad_name":null,"verse_count":5,"first_verse_id":97541,"last_verse_id":97545,"source_english":"Dasam Bani","source_unicode":"ਦਸਮ ਬਾਣੀ","writer":"Guru Gobind Singh Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":97541,"page_no":539,"line_no":97541,"gurmukhi":"ਚੌਪਈ ॥","translit_en":"chauapiee ||","translation":{"en":{"bdb":"CHAUPAI"},"pu":{"ss":"ਚੌਪਈ:"}}},{"verse_id":97542,"page_no":539,"line_no":97542,"gurmukhi":"ਫੇਰਿ ਨੈਮਖ੍ਵਾਰਨ ਮਹਿ ਆਯੋ ॥","translit_en":"fer naimakhavaiaaran meh aayo ||","translation":{"pu":{"ss":"(ਉਹ) ਫਿਰ ਨੇਮਖ੍ਵਾਰਨ (ਨੇਮਿਸ਼ਾਰਣਯ) ਵਿਚ ਆ ਗਿਆ,"}}},{"verse_id":97543,"page_no":539,"line_no":97543,"gurmukhi":"ਆਇ ਰਿਖਿਨ ਕਉ ਮਾਥ ਨਿਵਾਯੋ ॥","translit_en":"aai rikhin kau maath nivaayo ||","translation":{"en":{"bdb":"Then again he came back to Nemisharan and he bowed his head before all the sages"},"pu":{"ss":"ਆ ਕੇ ਰਿਸ਼ੀਆਂ ਨੂੰ ਸਿਰ ਨਿਵਾਇਆ।"}}},{"verse_id":97544,"page_no":539,"line_no":97544,"gurmukhi":"ਤੀਰਥ ਕਹਿਯੋ ਮੈ ਸਭ ਹੀ ਕਰੇ ॥","translit_en":"teerath kahiyo mai sabh hee kare ||","translation":{"pu":{"ss":"(ਉਸ ਨੇ) ਕਿਹਾ, ਮੈਂ ਸਾਰਿਆ ਤੀਰਥਾ ਦੀ ਵਿਧੀ ਪੂਰਵਕ (ਯਾਤ੍ਰਾ) ਕੀਤੀ ਹੈ,"}}},{"verse_id":97545,"page_no":539,"line_no":97545,"gurmukhi":"ਬਿਧਿ ਪੂਰਬ ਜਿਉ ਤੁਮ ਉਚਰੇ ॥੨੩੯੦॥","translit_en":"bidh poorab jiau tum uchare ||2390||","translation":{"en":{"bdb":"Then he said, “Just as you had said, I have taken bath at all the pilgrim-stations according to Shastric injunctions.2390."},"pu":{"ss":"ਜਿਵੇਾਂ ਤੁਸੀਂ ਕਿਹਾ ਸੀ ॥੨੩੯੦॥"}}}],"nav":{"prev":9122,"next":9124}}