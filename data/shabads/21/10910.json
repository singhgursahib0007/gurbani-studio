_no":118734,"gurmukhi":"ਦੁਤਿਯ ਪਹਰ ਆਨਿ ਜਬ ਲਾਗਿਯੋ ॥","translit_en":"dhutiy pahar aan jab laagiyo ||","translation":{"pu":{"ss":"ਜਦ ਦੂਜਾ ਪਹਿਰ ਸ਼ੁਰੂ ਹੋਇਆ"}}},{"verse_id":118735,"page_no":975,"line_no":118735,"gurmukhi":"ਚਿਤ੍ਰਯੋ ਛੋਰਿ ਮੂਰਛਨਾ ਜਾਗਿਯੋ ॥੧੧॥","translit_en":"chitrayo chhor moorachhanaa jaagiyo ||11||","translation":{"en":{"bdb":"When the second watch approached, he regained the consciousness.( 11)"},"pu":{"ss":"ਤਾ ਬੇਹੋਸ਼ੀ ਨੂੰ ਛਡ ਕੇ ਸਚੇਤ ਹੋ ਕੇ ਜਾਗ ਪਿਆ ॥੧੧॥"}}}],"nav":{"prev":10909,"next":10911}}