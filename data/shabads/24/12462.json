aj ieh saap chabaayo ||7||","translation":{"pu":{"ss":"(ਅਤੇ ਕਿਹਾ) ਸੱਪ ਦੇ ਡੰਗਣ ਨਾਲ ਇਹ ਮਰ ਗਿਆ ਹੈ ॥੭॥"}}},{"verse_id":131518,"page_no":1222,"line_no":131518,"gurmukhi":"ਭਲੀ ਭਾਤ ਤਨ ਤਾਹਿ ਗਡਾਯੋ ॥","translit_en":"bhalee bhaat tan taeh gaddaayo ||","translation":{"pu":{"ss":"ਉਸ ਦਾ ਸ਼ਰੀਰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਗਡਵਾ ਦਿੱਤਾ"}}},{"verse_id":131519,"page_no":1222,"line_no":131519,"gurmukhi":"ਯੌ ਕਾਜੀ ਤਨ ਆਪੁ ਜਤਾਯੋ ॥","translit_en":"yau kaajee tan aap jataayo ||","translation":{"pu":{"ss":"ਅਤੇ ਆਪ ਕਾਜ਼ੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,"}}},{"verse_id":131520,"page_no":1222,"line_no":131520,"gurmukhi":"ਸਾਜ ਬਾਜਿ ਇਕ ਯਾ ਕੋ ਘੋਰੋ ॥","translit_en":"saaj baaj ik yaa ko ghoro ||","translation":{"pu":{"ss":"ਇਸ ਦਾ ਸਾਮਾਨ ਅਤੇ ਇਕ ਘੋੜਾ"}}},{"verse_id":131521,"page_no":1222,"line_no":131521,"gurmukhi":"ਔਰ ਜੁ ਕਛੁ ਯਾ ਕੌ ਧਨੁ ਥੋਰੋ ॥੮॥","translit_en":"aauar ju kachh yaa kau dhan thoro ||8||","translation":{"pu":{"ss":"ਅਤੇ ਥੋੜਾ ਜਿਹਾ ਧਨ (ਮੇਰੇ ਪਾਸ ਹੈ) ॥੮॥"}}},{"verse_id":131522,"page_no":1222,"line_no":131522,"gurmukhi":"ਸੋ ਇਹ ਤ੍ਰਿਯਹਿ ਪਠਾਵਨ ਕੀਜੈ ॥","translit_en":"so ieh tirayeh paThaavan keejai ||","translation":{"pu":{"ss":"ਉਹ ਇਸ ਦੀ ਇਸਤਰੀ ਨੂੰ ਭੇਜ ਦਿਓ"}}},{"verse_id":131523,"page_no":1222,"line_no":131523,"gurmukhi":"ਫਾਰਖਤੀ ਹਮ ਕੌ ਲਿਖਿ ਦੀਜੈ ॥","translit_en":"faarakhatee ham kau likh dheejai ||","translation":{"pu":{"ss":"ਅਤੇ ਮੈਨੂੰ ਫ਼ਾਰਖ਼ਤੀ (ਬੇਬਾਕੀ) ਲਿਖ ਦਿਓ।"}}},{"verse_id":131524,"page_no":1222,"line_no":131524,"gurmukhi":"ਕਬੁਜ ਲਿਖਾ ਕਾਜੀ ਤੇ ਲਈ ॥","translit_en":"kabuj likhaa kaajee te liee ||","translation":{"pu":{"ss":"(ਉਸ ਨੇ) ਕਾਜ਼ੀ ਤੋਂ ਰਸੀਦ ('ਕਬੁਜ') ਲਿਖਵਾ ਲਈ"}}},{"verse_id":131525,"page_no":1222,"line_no":131525,"gurmukhi":"ਕਛੁ ਧਨ ਮ੍ਰਿਤਕ ਤ੍ਰਿਯਾ ਕਹ ਦਈ ॥੯॥","translit_en":"kachh dhan mritak tirayaa keh dhiee ||9||","translation":{"pu":{"ss":"ਅਤੇ ਕੁਝ ਧਨ ਮ੍ਰਿਤਕ ਦੀ ਇਸਤਰੀ ਨੂੰ ਦੇ ਦਿੱਤਾ ॥੯॥"}}}],"nav":{"prev":12461,"next":12463}}