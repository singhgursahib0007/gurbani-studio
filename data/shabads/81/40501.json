{"shabad":{"shabad_id":40501,"source_id":"B","writer_id":22,"raag_id":0,"page_no":22,"shabad_name":null,"verse_count":9,"first_verse_id":204078,"last_verse_id":204086,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":204078,"page_no":22,"line_no":17,"gurmukhi":"੧੭ : ਸਤਿਗੁਰ ਮਹਿਮਾ","translit_en":"17 : satigur mahimaa","translation":{"en":{"bdb":"Glory of the true Guru "}}},{"verse_id":204079,"page_no":22,"line_no":17,"gurmukhi":"ਅਬਿਗਤਿ ਗਤਿ ਅਸਗਾਹ ਆਖਿ ਵਖਾਣੀਐ।","translit_en":"abigat gat asagaeh aakh vakhaaneeaai|","translation":{"en":{"bdb":"The dynamism of the Guru is unmanifest and unfathomable."}}},{"verse_id":204080,"page_no":22,"line_no":17,"gurmukhi":"ਗਹਿਰ ਗੰਭੀਰ ਅਥਾਹ ਹਾਥਿ ਨ ਆਣੀਐ।","translit_en":"gahir ga(n)bheer athaeh haath na aaneeaai|","translation":{"en":{"bdb":"It is so deep and sublime that its extent cannot be known."}}},{"verse_id":204081,"page_no":22,"line_no":17,"gurmukhi":"ਬੂੰਦ ਲਖ ਪਰਵਾਹਿ ਹੁਲੜ ਵਾਣੀਐ।","translit_en":"boo(n)dh lakh paravaeh hulaR vaaneeaai|","translation":{"en":{"bdb":"As from each drop become many tumultuous rivulets,"}}},{"verse_id":204082,"page_no":22,"line_no":17,"gurmukhi":"ਗੁਰਮੁਖਿ ਸਿਫਤਿ ਸਲਾਹ ਅਕਥ ਕਹਾਣੀਐ।","translit_en":"gurmukh sifat salaeh akath kahaaneeaai|","translation":{"en":{"bdb":"Likewise the ever-growing glory of gurmukhs becomes ineffable."}}},{"verse_id":204083,"page_no":22,"line_no":17,"gurmukhi":"ਪਾਰਾਵਾਰੁ ਨ ਰਾਹੁ ਬਿਅੰਤੁ ਸੁਹਾਣੀਐ।","translit_en":"paaraavaar na raahu bia(n)t suhaaneeaai|","translation":{"en":{"bdb":"His shores near and far cannot be known and He is adorned in infinite ways."}}},{"verse_id":204084,"page_no":22,"line_no":17,"gurmukhi":"ਲਉਬਾਲੀ ਦਰਗਾਹ ਨ ਆਵਣ ਜਾਣੀਐ।","translit_en":"laubaalee dharagaeh na aavan jaaneeaai|","translation":{"en":{"bdb":"The comings and goings cease after entering the court of the Lord i.e. one becomes liberated from the bondage of  transmigration."}}},{"verse_id":204085,"page_no":22,"line_no":17,"gurmukhi":"ਵਡਾ ਵੇਪਰਵਾਹ ਤਾਣੁ ਨਿਤਾਣੀਐ।","translit_en":"vaddaa veparavaeh taan nitaaneeaai|","translation":{"en":{"bdb":"The true Guru is totally carefree yet He is the power of the powerless ones."}}},{"verse_id":204086,"page_no":22,"line_no":17,"gurmukhi":"ਸਤਿਗੁਰ ਸਚੇ ਵਾਹੁ ਹੋਇ ਹੈਰਾਣੀਐ ॥੧੭॥","translit_en":"satigur sache vaahu hoi hairaaneeaai ||17||","translation":{"en":{"bdb":"Blessed is the true Guru, seeing whom all feel wonderstruck"}}}],"nav":{"prev":40500,"next":40502}}