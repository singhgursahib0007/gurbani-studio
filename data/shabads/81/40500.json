{"shabad":{"shabad_id":40500,"source_id":"B","writer_id":22,"raag_id":0,"page_no":22,"shabad_name":null,"verse_count":9,"first_verse_id":204069,"last_verse_id":204077,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":204069,"page_no":22,"line_no":16,"gurmukhi":"੧੬ : ਗੁਰਮੁਖ ਰਹਿਣੀ","translit_en":"16 : gurmukh rahinee","translation":{"en":{"bdb":"Conduct of the gurmukhs "}}},{"verse_id":204070,"page_no":22,"line_no":16,"gurmukhi":"ਚਲਣੁ ਹੁਕਮੁ ਰਜਾਇ ਗੁਰਮੁਖਿ ਜਾਣਿਆ।","translit_en":"chalan hukam rajai gurmukh jaaniaa|","translation":{"en":{"bdb":"Gurmukhs know well how to move according to the command, hukam of the Lord."}}},{"verse_id":204071,"page_no":22,"line_no":16,"gurmukhi":"ਗੁਰਮੁਖਿ ਪੰਥਿ ਚਲਾਇ ਚਲਣੁ ਭਾਣਿਆ।","translit_en":"gurmukh pa(n)th chalai chalan bhaaniaa|","translation":{"en":{"bdb":"Gurmukh has ordained that community (panth), who moves in the will of Lord."}}},{"verse_id":204072,"page_no":22,"line_no":16,"gurmukhi":"ਸਿਦਕ ਸਬੂਰੀ ਪਾਇ ਕਰਿ ਸੁਕਰਾਣਿਆ।","translit_en":"sidhak sabooree pai kar sukaraaniaa|","translation":{"en":{"bdb":"Becoming contented and true to faith they gratefully thank the Lord."}}},{"verse_id":204073,"page_no":22,"line_no":16,"gurmukhi":"ਗੁਰਮੁਖਿ ਅਲਖੁ ਲਖਾਇ ਚੋਜ ਵਿਡਾਣਿਆ।","translit_en":"gurmukh alakh lakhai choj viddaaniaa|","translation":{"en":{"bdb":"Gurmukhs perceive His wondrous sport."}}},{"verse_id":204074,"page_no":22,"line_no":16,"gurmukhi":"ਵਰਤਣ ਬਾਲ ਸੁਭਾਇ ਆਦਿ ਵਖਾਣਿਆ।","translit_en":"varatan baal subhai aadh vakhaaniaa|","translation":{"en":{"bdb":"They behave innocently like children and eulogize the primaeval Lord."}}},{"verse_id":204075,"page_no":22,"line_no":16,"gurmukhi":"ਸਾਧਸੰਗਤਿ ਲਿਵ ਲਾਇ ਸਚੁ ਸੁਹਾਣਿਆ।","translit_en":"saadhasa(n)gat liv lai sach suhaaniaa|","translation":{"en":{"bdb":"They merge their consciousness in the holy congregation and truth do they love."}}},{"verse_id":204076,"page_no":22,"line_no":16,"gurmukhi":"ਜੀਵਨ ਮੁਕਤਿ ਕਰਾਇ ਸਬਦੁ ਸਿਞਾਣਿਆ।","translit_en":"jeevan mukat karai sabadh sin(j)aaniaa|","translation":{"en":{"bdb":"Identifying the word they get liberated and"}}},{"verse_id":204077,"page_no":22,"line_no":16,"gurmukhi":"ਗੁਰਮੁਖਿ ਆਪੁ ਗਵਾਇ ਆਪੁ ਪਛਾਣਿਆ ॥੧੬॥","translit_en":"gurmukh aap gavai aap pachhaaniaa ||16||","translation":{"en":{"bdb":"Loosing their sense of ego they perceive their inner selves."}}}],"nav":{"prev":40499,"next":40501}}