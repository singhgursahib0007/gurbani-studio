{"shabad":{"shabad_id":40772,"source_id":"B","writer_id":22,"raag_id":0,"page_no":34,"shabad_name":null,"verse_count":7,"first_verse_id":206245,"last_verse_id":206251,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":206245,"page_no":34,"line_no":18,"gurmukhi":"੧੮ : ਸਤਿਗੁਰ ਬਾਝ ਸੁਖ ਨਹੀਂ","translit_en":"18 : satigur baajh sukh nahee(n)","translation":{"en":{"bdb":"No happiness without true Guru   "}}},{"verse_id":206246,"page_no":34,"line_no":18,"gurmukhi":"ਕੋਟੀਂ ਸਾਦੀਂ ਕੇਤੜੇ ਜੰਗਲ ਭੂਪਾਲਾ।","translit_en":"koTee(n) saadhee(n) ketaRe ja(n)gal bhoopaalaa|","translation":{"en":{"bdb":"Many are engrossed in myriad of tastes, and many are the kings of the forests."}}},{"verse_id":206247,"page_no":34,"line_no":18,"gurmukhi":"ਥਲੀਂ ਵਰੋਲੇ ਕੇਤੜੇ ਪਰਬਤ ਬੇਤਾਲਾ।","translit_en":"thalee(n) varole ketaRe parabat betaalaa|","translation":{"en":{"bdb":"Many are the places, whirlwinds, mountains and the ghosts."}}},{"verse_id":206248,"page_no":34,"line_no":18,"gurmukhi":"ਨਦੀਆਂ ਨਾਲੇ ਕੇਤੜੇ ਸਰਵਰ ਅਸਰਾਲਾ।","translit_en":"nadheeaa(n) naale ketaRe saravar asaraalaa|","translation":{"en":{"bdb":"Many are the rivers, streams and the deep tanks."}}},{"verse_id":206249,"page_no":34,"line_no":18,"gurmukhi":"ਅੰਬਰਿ ਤਾਰੇ ਕੇਤੜੇ ਬਿਸੀਅਰੁ ਪਾਤਾਲਾ।","translit_en":"a(n)bar taare ketaRe biseear paataalaa|","translation":{"en":{"bdb":"The sky has many a star and in the nether world innumerable are the serpents."}}},{"verse_id":206250,"page_no":34,"line_no":18,"gurmukhi":"ਭੰਭਲਭੂਸੇ ਭੁਲਿਆਂ ਭਵਜਲ ਭਰਨਾਲਾ।","translit_en":"bha(n)bhalabhoose bhuliaa(n) bhavajal bharanaalaa|","translation":{"en":{"bdb":"Many are wandering confused in the labyrinth of world."}}},{"verse_id":206251,"page_no":34,"line_no":18,"gurmukhi":"ਇਕਸੁ ਸਤਿਗੁਰ ਬਾਹਰੇ ਸਭਿ ਆਲ ਜੰਜਾਲਾ ॥੧੮॥","translit_en":"eikas satigur baahare sabh aal ja(n)jaalaa ||18||","translation":{"en":{"bdb":"Without one true Guru all else are perplexities."}}}],"nav":{"prev":40771,"next":40773}}