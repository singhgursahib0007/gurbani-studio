{"shabad":{"shabad_id":40504,"source_id":"B","writer_id":22,"raag_id":0,"page_no":22,"shabad_name":null,"verse_count":9,"first_verse_id":204105,"last_verse_id":204113,"source_english":"Bhai Gurdas Ji Vaaran","source_unicode":"ਭਾਈ ਗੁਰਦਾਸ ਜੀ ਵਾਰਾਂ","writer":"Bhai Gurdaas Ji","writer_unicode":null,"raag":null,"raag_unicode":null},"verses":[{"verse_id":204105,"page_no":22,"line_no":20,"gurmukhi":"੨੦ : ਗੁਰਮੁਖ ਰਹਿਣੀ","translit_en":"20 : gurmukh rahinee","translation":{"en":{"bdb":"Conduct of the gurmukhs "}}},{"verse_id":204106,"page_no":22,"line_no":20,"gurmukhi":"ਗੁਰਸਿਖਾ ਜੈਕਾਰੁ ਸਤਿਗੁਰ ਪਾਇਆ।","translit_en":"gursikhaa jaikaar satigur paiaa|","translation":{"en":{"bdb":"Those gurmukhs are acclaimed who have found the true Guru."}}},{"verse_id":204107,"page_no":22,"line_no":20,"gurmukhi":"ਪਰਵਾਰੈ ਸਾਧਾਰ ਸਬਦੁ ਕਮਾਇਆ।","translit_en":"paravaarai saadhaar sabadh kamaiaa|","translation":{"en":{"bdb":"Practising the Word, they have emancipated their whole families."}}},{"verse_id":204108,"page_no":22,"line_no":20,"gurmukhi":"ਗੁਰਮੁਖਿ ਸਚੁ ਆਚਾਰ ਭਾਣਾ ਭਾਇਆ।","translit_en":"gurmukh sach aachaar bhaanaa bhaiaa|","translation":{"en":{"bdb":"Gurmukhs have the Will of God and they work according to the truth."}}},{"verse_id":204109,"page_no":22,"line_no":20,"gurmukhi":"ਗੁਰਮੁਖਿ ਮੋਖ ਦੁਆਰ ਆਪੁ ਗਵਾਇਆ।","translit_en":"gurmukh mokh dhuaar aap gavaiaa|","translation":{"en":{"bdb":"Eschewing ego, they obtain the door of liberation."}}},{"verse_id":204110,"page_no":22,"line_no":20,"gurmukhi":"ਗੁਰਮੁਖਿ ਪਰਉਪਕਾਰ ਮਨ ਸਮਝਾਇਆ।","translit_en":"gurmukh paraupakaar man samajhaiaa|","translation":{"en":{"bdb":"The gurmukhs have made the mind understand the principle of altruism."}}},{"verse_id":204111,"page_no":22,"line_no":20,"gurmukhi":"ਗੁਰਮੁਖਿ ਸਚੁ ਆਧਾਰ ਸਚਿ ਸਮਾਇਆ।","translit_en":"gurmukh sach aadhaar sach samaiaa|","translation":{"en":{"bdb":"The base of gurmukhs is truth and they (finally) get absorbd into truth."}}},{"verse_id":204112,"page_no":22,"line_no":20,"gurmukhi":"ਗੁਰਮੁਖਾ ਲੋਕਾਰ ਲੇਪੁ ਨ ਲਾਇਆ।","translit_